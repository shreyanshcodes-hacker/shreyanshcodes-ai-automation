# Environment: development | test | production
APP_ENV=development

# Security & CORS (REQUIRED in production: strong >=32-char AUTH_SECRET, HTTPS origins)
AUTH_SECRET=dev-only-insecure-secret-change-me
ALLOW_DEV_AUTH_BYPASS=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=86400

# Gemini (Content & Structured Scene Plan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENCY=4

# ElevenLabs (Authorized AI Voiceover — fail-closed)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_AUTHORIZED_VOICE_IDS=
ELEVENLABS_VOICE_CONSENT_VERIFIED=false
ELEVENLABS_MAX_CONCURRENCY=2

# Replicate (AI Visuals)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
REPLICATE_SCHEMA_PRESET=auto
REPLICATE_MAX_CONCURRENCY=3

# Storage & Database
OUTPUT_DIR=./storage
DATABASE_PATH=./storage/studio.db
DATABASE_URL=
REDIS_URL=

# Production Cadence & Publishing Safety
PUBLISH_MODE=private_queue
SHORTS_PER_DAY=2
LONG_VIDEOS_PER_WEEK=2
DEFAULT_LANGUAGE=Hinglish

# YouTube OAuth 2.0 & Safety Gates (HTTPS redirect URI required in production)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
YOUTUBE_TOKEN_FILE=./storage/tokens/youtube_oauth.json
YOUTUBE_PUBLIC_SCHEDULING_ENABLED=false
YOUTUBE_KILL_SWITCH=false
YOUTUBE_DAILY_QUOTA_LIMIT=10000
