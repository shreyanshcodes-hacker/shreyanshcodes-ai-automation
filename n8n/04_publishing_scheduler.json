{
  "name": "04 - Publishing Scheduler (Private-First QA Gate)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 */2 * * *" }]
        }
      },
      "id": "cron-publish",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 240]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.STUDIO_API_URL || 'http://localhost:8000'}}/api/jobs?limit=20"
      },
      "id": "http-list-jobs",
      "name": "Fetch Completed Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 240]
    }
  ],
  "connections": {
    "Every 2 Hours": {
      "main": [[{ "node": "Fetch Completed Jobs", "type": "main", "index": 0 }]]
    }
  },
  "active": false
}
