      },
      "id": "http-research",
      "name": "Generate Topic Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 240]
    }
  ],
  "connections": {
    "Daily 08:00 Trigger": {
      "main": [[{ "node": "Generate Topic Ideas", "type": "main", "index": 0 }]]
